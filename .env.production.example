# ─── Turnos IA · production ─────────────────────────────────────────────
# Copy to .env.production on the server and fill in. Never commit it.
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# Guide: deploy/README.md

# Public domain (its DNS must point to this server). Caddy gets the HTTPS certificate.
DOMAIN=turnos.miclinica.com.ar
APP_URL=https://turnos.miclinica.com.ar
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Database password (the database is not reachable from the internet).
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# ─── Keys: generate NEW ones here, never reuse development keys ─────────
#   openssl rand -base64 32      (one per line)
# PII_ENCRYPTION_KEY encrypts patient phones and emails. If it is lost, they
# are lost. Store a copy in a password manager, APART from the backups.
PII_ENCRYPTION_KEY=
PII_HASH_KEY=
BETTER_AUTH_SECRET=

# ─── Panel security ─────────────────────────────────────────────────────
# Roles that must use two-factor (authenticator app) to enter the panel.
TWO_FACTOR_REQUIRED_ROLES=superadmin,clinic_admin

# ─── Email (SMTP) ───────────────────────────────────────────────────────
# Any provider works: Brevo (smtp-relay.brevo.com:587), Amazon SES, Resend
# (smtp.resend.com:465), Gmail (smtp.gmail.com:465 with an app password)…
# Without SMTP_HOST nothing is sent: emails stay in Panel → Emails (test inbox).
# Set SPF, DKIM and DMARC for the sender's domain or they will land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Centro Médico <turnos@miclinica.com.ar>"

# ─── Background jobs (emails, reminders, cleanup) ───────────────────────
# They run inside the app. Set false only if you run `pnpm jobs` from cron instead.
JOBS_ENABLED=true

# ─── Error alerts (optional) ────────────────────────────────────────────
# Each server error is POSTed here as JSON (Slack/Discord webhook, log collector…).
# Errors are always written to the app logs anyway (docker compose logs app).
ERROR_WEBHOOK_URL=

# ─── Backups ────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# ─── AI assistant (optional; without keys patients use the form) ────────
AI_ENABLED=true
LLM_PROVIDERS=groq,gemini,openrouter
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_DAILY_TOKEN_LIMIT=300000
CHAT_RETENTION_DAYS=30
LLM_MOCK=
