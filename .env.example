# ─── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Argentina/Buenos_Aires

# ─── Database ───────────────────────────────────────────────────────────
# docker compose -f docker-compose.dev.yml up -d   → port 5432
# or, without Docker: pnpm db:embedded              → port 5433
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/turnos

# ─── Personal data protection ───────────────────────────────────────────
# 32 random bytes in base64 each:  openssl rand -base64 32
# Back up PII_ENCRYPTION_KEY apart from database dumps: without it,
# stored phones and emails cannot be read.
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

# ─── Admin authentication ───────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ─── Demo data ──────────────────────────────────────────────────────────
# Password for the demo users created by `pnpm seed` (min. 10 chars).
# If empty, a random one is generated and printed once.
SEED_ADMIN_PASSWORD=

# ─── AI assistant (optional) ────────────────────────────────────────────
# Without any key the assistant is off and patients use the form.
# Free tiers by default. Providers are tried in this order; the next one
# takes over on errors, rate limits or timeouts.
# Note: free tiers may use prompts to improve their models. The assistant
# never sends names, phones or emails (see DECISIONS.md, IA section).
AI_ENABLED=true
LLM_PROVIDERS=groq,gemini,openrouter
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Tokens per day for all conversations together. Past it, the chat offers the form.
LLM_DAILY_TOKEN_LIMIT=300000
LLM_CONVERSATION_TOKEN_LIMIT=40000
LLM_CONVERSATION_MESSAGE_LIMIT=40
LLM_TIMEOUT_MS=20000
LLM_MAX_TOOL_ROUNDS=4
# Conversations are deleted after this many days.
CHAT_RETENTION_DAYS=30
# Scripted local model for demos and tests, no keys needed. Never in production.
LLM_MOCK=
